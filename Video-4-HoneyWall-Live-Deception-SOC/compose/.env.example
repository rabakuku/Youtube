# filepath: https://github.com/rabakuku/Youtube/blob/main/Video-4-HoneyWall-Live-Deception-SOC/compose/.env.example
# HoneyWall - environment file
# setup.sh copies this to .env (once) and asks for the values marked <...>.
# NEVER commit .env - it holds your FortiGate token and LLM key.

# ------------------------------------------------------------------
# Profiles:  lite | standard | full   (+ optional add-on llm-tailscale)
#   standard = cowrie + engine + dashboard + ntfy + web decoy (the video build)
#   LLM over Cloudflare (default here): no extra profile needed
#   LLM over Tailscale:                 COMPOSE_PROFILES=standard,llm-tailscale
# ------------------------------------------------------------------
COMPOSE_PROFILES=standard
TZ=UTC

# ------------------------------------------------------------------
# Images (pinned; bump deliberately)
# ------------------------------------------------------------------
COWRIE_IMAGE=cowrie/cowrie:3.1.5
NTFY_IMAGE=binwiederhier/ntfy:v2.37.2
DOZZLE_IMAGE=amir20/dozzle:v11.4.0
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.5

# ------------------------------------------------------------------
# Host ports on Alpine (see docs/Lab-Matrix.md section 12)
# ------------------------------------------------------------------
COWRIE_HOST_PORT=2222
WEB_DECOY_HOST_PORT=8088
DASHBOARD_HOST_PORT=80
NTFY_HOST_PORT=8090
DOZZLE_HOST_PORT=9999

# ------------------------------------------------------------------
# Docker network (internal to Alpine, never routed)
# ------------------------------------------------------------------
DOCKER_SUBNET=172.28.10.0/24
DOCKER_GATEWAY=172.28.10.1
COWRIE_CONTAINER_IP=172.28.10.10
ENGINE_CONTAINER_IP=172.28.10.20
DASHBOARD_CONTAINER_IP=172.28.10.30
NTFY_CONTAINER_IP=172.28.10.40
DOZZLE_CONTAINER_IP=172.28.10.50
TAILSCALE_CONTAINER_IP=172.28.10.60
WEB_DECOY_CONTAINER_IP=172.28.10.70

# ------------------------------------------------------------------
# Lab identity (used for dashboard topology labels and rules)
# ------------------------------------------------------------------
FGT_HOST=192.168.10.1
FGT_WAN_IP=172.24.66.58
ALPINE_IP=192.168.10.2
KALI_IP=192.168.40.3
DECOY_VIP_IP=192.168.40.1
DECOY_VIP_PORT=22
DECOY_HOSTNAME=srv-corp-ssh01
# The "leaked" account that Act 3 logs in with (password lives in compose/userdb.txt)
DECOY_LEAKED_USER=svc_backup
DECOY_LEAKED_UID=1001

# ------------------------------------------------------------------
# FortiGate REST API (Stage 5 creates the API user and token)
#   execute api-user generate-key api_honeywall
# ------------------------------------------------------------------
FGT_API_TOKEN=<FGT_API_TOKEN>
FGT_VDOM=root
FGT_VERIFY_TLS=false
# Rehearsal mode: true = fake FortiGate inside the engine (no API calls) and the
# dashboard simulator (/api/test/simulate) is enabled. Set false for the real show.
FGT_SIMULATE=false
# How often the engine re-reads the FortiGate ban list (seconds)
BAN_POLL_SEC=3
# rest-ban = POST /api/v2/monitor/user/banned/add_users
ENFORCEMENT_MODE=rest-ban
# 0 = permanent until Unban on the dashboard
BAN_EXPIRY=0
# Also close the attacker's existing sessions after the ban (verified in Stage 5)
FGT_CLOSE_SESSIONS=true
# Never ban these (comma-separated CIDRs) - protects the servers VLAN and FortiGate
NEVER_BAN=192.168.10.0/24,172.24.66.58/32
# Ignore events from these sources completely (Docker healthchecks probe the decoys from loopback)
IGNORE_SOURCES=127.0.0.0/8,::1/128

# ------------------------------------------------------------------
# Detection rules
# ------------------------------------------------------------------
# Act 2: ban after N failed logins inside the window
BRUTE_THRESHOLD=5
BRUTE_WINDOW_SEC=30
# Act 3: touching any of these paths = instant ban (comma-separated)
HONEYTOKENS=/root/.aws/credentials,/home/svc_backup/passwords.txt,/opt/backup/db_dump.sql
# Web decoy (FortiGate VIP 192.168.40.1:80 -> 192.168.10.2:8088)
WEB_DECOY_ENABLED=true
WEB_DECOY_VIP_PORT=80
WEB_DECOY_TITLE=Corp Backup Console
WEB_DECOY_HOSTNAME=backup.corp.local
# Downloading any of these over HTTP = instant ban (comma-separated URL paths)
WEB_HONEYTOKENS=/.env,/backup/.env.bak,/backup/db_dump.sql
# Commands that raise the threat score (comma-separated substrings)
HIGH_RISK_COMMANDS=wget ,curl ,chmod +x,tftp ,nc ,base64 -d,/dev/tcp,crontab,history -c,rm -rf
# Seconds to wait after a quarantine before writing the incident report
# (lets the last commands of the session land in the report)
REPORT_DELAY_SEC=4

# ------------------------------------------------------------------
# Dashboard
# ------------------------------------------------------------------
DASHBOARD_TITLE=HoneyWall
# hollywood | enterprise
DASHBOARD_THEME=hollywood
DASHBOARD_SOUND=true
DASHBOARD_FLASH=true
# full | split
DASHBOARD_LAYOUT=full
# Optional access token for the dashboard/API (empty = open inside the lab).
# Generate: openssl rand -hex 16
DASHBOARD_TOKEN=
# URL you open from the Windows PC (FortiGate WAN VIP 8080)
DASHBOARD_PUBLIC_URL=http://172.24.66.58:8080

# ------------------------------------------------------------------
# ntfy alerts (standard/full profiles)
# ------------------------------------------------------------------
NTFY_ENABLED=true
NTFY_URL=http://ntfy:80
NTFY_TOPIC=honeywall
# URL you open from the Windows PC (FortiGate WAN VIP 8090)
NTFY_BASE_URL=http://172.24.66.58:8090

# ------------------------------------------------------------------
# Optional LLM incident report (home Ollama behind Cloudflare or Tailscale)
# Run scripts/llm-host-setup.sh on the GPU box - it prints these exact lines.
# Toggle: this line, setup.sh --llm on|off, or the dashboard "AI reports" switch.
# ------------------------------------------------------------------
LLM_ENABLED=false
# cloudflare | tailscale | direct
LLM_ACCESS_MODE=cloudflare
LLM_BASE_URL=https://llm.ccdtt.com
LLM_API_KEY=<LLM_API_KEY>
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SEC=60
# direct mode uses Caddy's self-signed cert -> set false there
LLM_VERIFY_TLS=true
# tailscale mode only: http://tailscale:1055 (the sidecar proxy). Empty for cloudflare/direct.
LLM_HTTP_PROXY=

# ------------------------------------------------------------------
# Tailscale sidecar (only with profile llm-tailscale)
# Create a reusable auth key: Tailscale admin -> Settings -> Keys
# ------------------------------------------------------------------
TS_AUTHKEY=<TS_AUTHKEY>
TS_HOSTNAME=honeywall-lab
TS_EXTRA_ARGS=
