{
 "uid": "visual-soc-hunting",
 "title": "Visual SOC 2 · Threat Hunting",
 "description": "Filter by verdict, source IP and port to investigate an incident.",
 "tags": [
  "fortigate",
  "soc",
  "loki",
  "visual-soc"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "schemaVersion": 39,
 "version": 1,
 "liveNow": false,
 "templating": {
  "list": [
   {
    "type": "custom",
    "name": "verdict",
    "label": "Verdict",
    "query": "blocked,allowed,detected",
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [
     {
      "selected": true,
      "text": "All",
      "value": "$__all"
     },
     {
      "selected": false,
      "text": "blocked",
      "value": "blocked"
     },
     {
      "selected": false,
      "text": "allowed",
      "value": "allowed"
     },
     {
      "selected": false,
      "text": "detected",
      "value": "detected"
     }
    ]
   },
   {
    "type": "textbox",
    "name": "srcip",
    "label": "Source IP (regex)",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "options": [
     {
      "selected": true,
      "text": ".*",
      "value": ".*"
     }
    ]
   },
   {
    "type": "textbox",
    "name": "dstport",
    "label": "Dest port (regex)",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "options": [
     {
      "selected": true,
      "text": ".*",
      "value": ".*"
     }
    ]
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [
  {
   "title": "Live Wallboard",
   "type": "link",
   "url": "/d/fortinet-visual-soc",
   "icon": "dashboard",
   "targetBlank": false
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Matching events",
   "description": "Events matching the filters in the selected time range.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 120,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum(count_over_time({source=\"fortigate\", verdict=~\"$verdict\"} | json | srcip=~`$srcip` | dstport=~`$dstport` [$__range])) or vector(0)",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Distinct sources",
   "description": "How many different source IPs match.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 120,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "count(sum by (srcip) (count_over_time({source=\"fortigate\", verdict=~\"$verdict\"} | json | srcip=~`$srcip` | dstport=~`$dstport` [$__range]))) or vector(0)",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "purple",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Distinct dest ports",
   "description": "Many ports from one source = a scan.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 120,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "count(sum by (dstport) (count_over_time({source=\"fortigate\", verdict=~\"$verdict\"} | json | srcip=~`$srcip` | dstport=~`$dstport` [$__range]))) or vector(0)",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 10
       },
       {
        "color": "red",
        "value": 50
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Bytes served (allowed)",
   "description": "Bytes returned to clients on allowed sessions (rcvdbyte).",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 120,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum(sum_over_time({source=\"fortigate\", log_type=\"traffic\", verdict=\"allowed\"} | json | srcip=~`$srcip` | dstport=~`$dstport` | unwrap rcvdbyte | __error__=\"\" [$__range])) or vector(0)",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 5,
   "type": "table",
   "title": "Conversations — who talked to what",
   "description": "Every source → destination:port pair, with the policy that handled it.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 10,
    "w": 14,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "topk(25, sum by (srcip, dstip, dstport, service, policyname, verdict) (count_over_time({source=\"fortigate\", log_type=\"traffic\", verdict=~\"$verdict\"} | json | srcip=~`$srcip` | dstport=~`$dstport` [$__range])))",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "srcip": "Source",
       "dstip": "Destination",
       "dstport": "Port",
       "service": "Service",
       "policyname": "Policy",
       "verdict": "Verdict",
       "Value #A": "Events",
       "Value": "Events"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Events",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Events"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "continuous-YlRd"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   }
  },
  {
   "id": 6,
   "type": "bargauge",
   "title": "Bandwidth hogs — top sources by bytes",
   "description": "Which clients pulled the most data through allowed policies.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 10,
    "w": 10,
    "x": 14,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "topk(5, sum by (srcip) (sum_over_time({source=\"fortigate\", log_type=\"traffic\", verdict=\"allowed\"} | json | srcip=~`$srcip` | dstport=~`$dstport` | unwrap rcvdbyte | __error__=\"\" [$__range])))",
     "queryType": "instant",
     "editorMode": "code",
     "legendFormat": "{{srcip}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "noValue": "No activity"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "sizing": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "minVizHeight": 16,
    "maxVizHeight": 40
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Events per policy",
   "description": "Which firewall policy is doing the work right now.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "interval": "30s",
   "maxDataPoints": 200,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum by (policyname) (count_over_time({source=\"fortigate\", log_type=\"traffic\", verdict=~\"$verdict\"} | json | srcip=~`$srcip` | dstport=~`$dstport` | policyname!=\"\" [$__interval]))",
     "queryType": "range",
     "editorMode": "code",
     "legendFormat": "{{policyname}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 2,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "showPoints": "never"
     },
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "type": "table",
   "title": "IPS hits by signature and source",
   "description": "Named attacks matched by the FortiGate IPS engine.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum by (attack, srcip, action, severity) (count_over_time({source=\"fortigate\", log_type=\"utm\"} | json | subtype=\"ips\" | srcip=~`$srcip` | dstport=~`$dstport` [$__range]))",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "attack": "Signature",
       "srcip": "Source",
       "action": "Action",
       "severity": "Severity",
       "Value #A": "Hits",
       "Value": "Hits"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Hits",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Hits"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "continuous-YlRd"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   }
  },
  {
   "id": 9,
   "type": "logs",
   "title": "Filtered event stream",
   "description": "Same filters, newest first. Expand a line for every field.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 22
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "{source=\"fortigate\", verdict=~\"$verdict\"} | json | srcip=~`$srcip` | dstport=~`$dstport` | line_format `{{ .verdict | upper }}  {{ .srcip }}:{{ .srcport }} → {{ .dstip }}:{{ .dstport }}  {{ .service }}  policy={{ .policyid }}{{ if .attack }}  IPS: {{ .attack }}{{ end }}`",
     "queryType": "range",
     "editorMode": "code",
     "maxLines": 200
    }
   ],
   "maxDataPoints": 200,
   "options": {
    "showTime": true,
    "showLabels": false,
    "showCommonLabels": false,
    "wrapLogMessage": false,
    "prettifyLogMessage": false,
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "sortOrder": "Descending"
   }
  }
 ]
}