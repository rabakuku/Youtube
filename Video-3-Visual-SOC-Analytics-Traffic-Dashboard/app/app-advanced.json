     "uid": "loki-fortigate"
    },
    "enable": true,
    "iconColor": "purple",
    "name": "Quarantine actions",
    "target": {
     "refId": "Anno",
     "expr": "{source=\"responder\", event=~\"quarantine|release\"} | json ip, event",
     "queryType": "range"
    },
    "textFormat": "{{event}} {{ip}}",
    "titleFormat": "Responder",
    "tagKeys": "event"
   }
  ]
 },
 "links": [
  {
   "title": "Live Wallboard",
   "type": "link",
   "url": "/d/fortinet-visual-soc",
   "icon": "dashboard",
   "targetBlank": false
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "alertlist",
   "title": "Detections — firing & pending",
   "description": "Grafana alert rules (app/alert-rules.yaml).",
   "gridPos": {
    "h": 8,
    "w": 10,
    "x": 0,
    "y": 0
   },
   "options": {
    "viewMode": "list",
    "groupMode": "default",
    "groupBy": [],
    "maxItems": 20,
    "sortOrder": 1,
    "dashboardAlerts": false,
    "alertName": "",
    "alertInstanceLabelFilter": "",
    "folder": {
     "title": "Visual SOC"
    },
    "stateFilter": {
     "firing": true,
     "pending": true,
     "noData": false,
     "normal": false,
     "error": true
    },
    "showInstances": true
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Port-scan score (60s)",
   "description": "Most distinct denied ports from one source in the last minute. Alert at > 20.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 8,
    "w": 5,
    "x": 10,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 60,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "max(count by (srcip) (sum by (srcip, dstport) (count_over_time({source=\"fortigate\", log_type=\"traffic\", verdict=\"blocked\"} | json [1m])))) or vector(0)",
     "queryType": "range",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 20
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "IPS hits (60s)",
   "description": "Any IPS match fires the web-attack alert.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 8,
    "w": 5,
    "x": 15,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 60,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum(count_over_time({source=\"fortigate\", log_type=\"utm\"} | json | subtype=\"ips\" [1m])) or vector(0)",
     "queryType": "range",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "QUARANTINED",
   "description": "IPs currently in SOC-Quarantine.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 8,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 60,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum(last_over_time({source=\"responder\", event=\"state\"} | json count | unwrap count [2m])) or vector(0)",
     "queryType": "range",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "NONE",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "purple",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NONE",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Scan detector — distinct denied ports per source (60s window)",
   "description": "Crossing 20 = port scan. Purple markers = quarantine / release.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 8
   },
   "interval": "15s",
   "maxDataPoints": 120,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "count by (srcip) (sum by (srcip, dstport) (count_over_time({source=\"fortigate\", log_type=\"traffic\", verdict=\"blocked\"} | json [1m])))",
     "queryType": "range",
     "editorMode": "code",
     "legendFormat": "{{srcip}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 2,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 20
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Quarantine at work — attempts blocked by SOC_Quarantine_Block",
   "description": "Every connection a quarantined IP tried after the ban.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 17
   },
   "interval": "15s",
   "maxDataPoints": 120,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum by (srcip) (count_over_time({source=\"fortigate\", log_type=\"traffic\", verdict=\"blocked\"} | json | policyname=\"SOC_Quarantine_Block\" [$__interval]))",
     "queryType": "range",
     "editorMode": "code",
     "legendFormat": "{{srcip}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "showPoints": "never"
     },
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "purple"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Response Actions",
   "description": "Approvals, quarantines, releases, failures — newest first.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 17
   },
   "maxDataPoints": 100,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "{source=\"responder\", event=~\"quarantine|release|ignored|approval_requested|allowlisted|quarantine_failed|release_failed\"} | json | label_format level=`{{ if eq .event \"quarantine\" }}error{{ else if eq .event \"release\" }}info{{ else if eq .event \"approval_requested\" }}warning{{ else if eq .event \"quarantine_failed\" }}critical{{ else if eq .event \"release_failed\" }}critical{{ else }}debug{{ end }}` | line_format `{{ .event | upper }}  {{ .ip }}{{ if .reason }}  · {{ .reason }}{{ end }}{{ if .by }}  · by {{ .by }}{{ end }}{{ if .why }}  · {{ .why }}{{ end }}{{ if eq .dry_run \"true\" }}  [DRY RUN]{{ end }}`",
     "queryType": "range",
     "editorMode": "code",
     "maxLines": 100
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": false,
    "showCommonLabels": false,
    "wrapLogMessage": false,
    "prettifyLogMessage": false,
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "sortOrder": "Descending"
   }
  },
  {
   "id": 8,
   "type": "table",
   "title": "Attacker profile — everything each blocked source tried",
   "description": "Per source: every blocked port, service, IPS signature and the policy that stopped it.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 26
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "topk(25, sum by (srcip, dstport, service, attack, policyname) (count_over_time({source=\"fortigate\", verdict=\"blocked\"} | json [$__range])))",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "srcip": "Source",
       "dstport": "Port",
       "service": "Service",
       "attack": "IPS signature",
       "policyname": "Blocked by",
       "Value #A": "Blocked",
       "Value": "Blocked"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Blocked",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Blocked"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "continuous-YlRd"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   }
  },
  {
   "id": 9,
   "type": "bargauge",
   "title": "Kill chain — blocked events by phase",
   "description": "Recon → exploit → contained. Egress = Kali tried to reach WAN.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 26
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum by (phase) (count_over_time({source=\"fortigate\", verdict=\"blocked\"} | json | label_format phase=`{{ if eq .policyname \"SOC_Quarantine_Block\" }}4 · Contained (quarantine){{ else if eq .log_type \"utm\" }}3 · Exploit (IPS){{ else if eq .policyname \"Kali_To_WAN_Deny\" }}5 · Egress attempt (WAN){{ else }}2 · Recon (port scan){{ end }}` [$__range]))",
     "queryType": "instant",
     "editorMode": "code",
     "legendFormat": "{{phase}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "noValue": "No activity"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "sizing": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "minVizHeight": 16,
    "maxVizHeight": 40
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Conversations — who talked to what",
   "description": "Every source → destination:port pair and the policy that handled it.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 36
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "topk(25, sum by (srcip, dstip, dstport, service, policyname, verdict) (count_over_time({source=\"fortigate\", log_type=\"traffic\"} | json [$__range])))",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "srcip": "Source",
       "dstip": "Destination",
       "dstport": "Port",
       "service": "Service",
       "policyname": "Policy",
       "verdict": "Verdict",
       "Value #A": "Events",
       "Value": "Events"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Events",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Events"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "continuous-YlRd"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   }
  }
 ]
}