{
 "uid": "visual-soc-basic",
 "title": "Visual SOC 1 · Quickstart (4 LogQL queries)",
 "description": "Teaching dashboard: the four LogQL building blocks behind the wallboard.",
 "tags": [
  "fortigate",
  "soc",
  "loki",
  "visual-soc"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "30s",
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "schemaVersion": 39,
 "version": 1,
 "liveNow": false,
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "links": [
  {
   "title": "Live Wallboard",
   "type": "link",
   "url": "/d/fortinet-visual-soc",
   "icon": "dashboard",
   "targetBlank": false
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Events (5m)",
   "description": "Query 1 — count every log line: sum(count_over_time({source=\"fortigate\"}[5m]))",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 120,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum(count_over_time({source=\"fortigate\"}[5m])) or vector(0)",
     "queryType": "range",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Blocked (5m)",
   "description": "Query 2 — same count, filtered on the verdict label Vector adds.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 120,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum(count_over_time({source=\"fortigate\", verdict=\"blocked\"}[5m])) or vector(0)",
     "queryType": "range",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Query 3 — Events per verdict over time",
   "description": "Group by a label to split one line into allowed / blocked / detected.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 5,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "interval": "30s",
   "maxDataPoints": 200,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum by (verdict) (count_over_time({source=\"fortigate\"}[$__interval]))",
     "queryType": "range",
     "editorMode": "code",
     "legendFormat": "{{verdict}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "showPoints": "never"
     },
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "blocked"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "allowed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "detected"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "type": "logs",
   "title": "Query 4 — Raw JSON exactly as Vector stored it",
   "description": "No parsing — expand a line to see every FortiOS field (srcip, dstport, policyid, attack...). This is what all other panels query.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 14,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "{source=\"fortigate\"}",
     "queryType": "range",
     "editorMode": "code",
     "maxLines": 200
    }
   ],
   "maxDataPoints": 200,
   "options": {
    "showTime": true,
    "showLabels": false,
    "showCommonLabels": false,
    "wrapLogMessage": false,
    "prettifyLogMessage": false,
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "sortOrder": "Descending"
   }
  }
 ]
}