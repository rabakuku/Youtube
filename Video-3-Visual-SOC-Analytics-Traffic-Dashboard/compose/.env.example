# filepath: https://github.com/rabakuku/Youtube/blob/main/Video-3-Visual-SOC-Analytics-Traffic-Dashboard/compose/.env.example
# -----------------------------------------------------------------------------
# Zero-Cost Visual SOC — environment variables (copied to compose/.env by setup.sh)
# setup.sh fills every CHANGE_ME value automatically and asks for FGT_API_TOKEN.
# compose/.env holds secrets: mode 600, never commit it.
# -----------------------------------------------------------------------------

# --- Pinned images ----------------------------------------------------------
VECTOR_IMAGE=timberio/vector:0.36.0-alpine
LOKI_IMAGE=grafana/loki:2.9.4
GRAFANA_IMAGE=grafana/grafana:10.3.3
NTFY_IMAGE=binwiederhier/ntfy:v2.11.0
RESPONDER_IMAGE=python:3.12.7-alpine3.20

# --- How the admin PC reaches the lab (FortiGate port1 VIPs) ----------------
PUBLIC_GRAFANA_URL=http://172.24.66.52:8080
PUBLIC_NTFY_URL=http://172.24.66.52:8090
PUBLIC_RESPONDER_URL=http://172.24.66.52:8091
TZ=UTC

# --- Grafana login ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
GRAFANA_ANONYMOUS_VIEWER=false

# --- ntfy -------------------------------------------------------------------
# Random topic name = the only "password" for the alert channel. Subscribe to
# http://172.24.66.52:8090/<NTFY_TOPIC> in a browser on the admin PC.
NTFY_TOPIC=CHANGE_ME_ntfy_topic

# --- Responder --------------------------------------------------------------
# approve = ntfy shows [Quarantine] [Ignore] buttons · auto = quarantine at once
QUARANTINE_MODE=approve
QUARANTINE_MINUTES=15
# Never quarantined: SOC VLAN (incl. FortiGate .10.1), attacker-VLAN gateway, admin side
QUARANTINE_ALLOWLIST=192.168.10.0/24,192.168.40.1/32,172.24.66.0/24
# Signs the button links (generated by setup.sh); links expire after LINK_TTL_SECONDS
RESPONDER_SECRET=CHANGE_ME_responder_secret
LINK_TTL_SECONDS=1800

# --- FortiGate REST API (Stage 4 creates the API user and prints the token) --
# Empty token = DRY-RUN: everything works except the actual FortiGate change.
FGT_HOST=192.168.10.1
FGT_API_TOKEN=
FGT_VERIFY_TLS=false
FGT_VDOM=root
FGT_QUARANTINE_GROUP=SOC-Quarantine
FGT_ADDR_PREFIX=Q-

# --- Loki / Vector ----------------------------------------------------------
LOKI_RETENTION_PERIOD=168h
VECTOR_LOG=info
