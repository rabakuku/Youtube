# filepath: https://github.com/rabakuku/Youtube/blob/main/Video-3-Visual-SOC-Analytics-Traffic-Dashboard/compose/.env.example
# -----------------------------------------------------------------------------
# Zero-Cost Visual SOC — environment variables
# Copy to compose/.env and change every CHANGE_ME value before first run:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# --- Pinned images ----------------------------------------------------------
VECTOR_IMAGE=timberio/vector:0.36.0-alpine
LOKI_IMAGE=grafana/loki:2.9.4
GRAFANA_IMAGE=grafana/grafana:10.3.3

# --- Grafana login ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Generate a strong one:  openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# true = anyone who can reach :80 sees the wallboard read-only (handy for a
# kiosk/second screen while recording). Keep false unless you want that.
GRAFANA_ANONYMOUS_VIEWER=false

# --- Loki -------------------------------------------------------------------
# How long logs are kept before the compactor deletes them (Go duration, multiple of 24h)
LOKI_RETENTION_PERIOD=168h

# --- Vector -----------------------------------------------------------------
# trace | debug | info | warn | error   (debug prints parse failures)
VECTOR_LOG=info
