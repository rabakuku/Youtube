      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum by (verdict) (count_over_time({source=\"fortigate\"}[$__interval]))",
     "queryType": "range",
     "editorMode": "code",
     "legendFormat": "{{verdict}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
