 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "THREAT LEVEL",
   "description": "Blocked events in the last 60 seconds. 0 = ALL CLEAR, 1-50 = ELEVATED, 51+ = UNDER ATTACK.",
   "datasource": {
    "type": "loki",
    "uid": "loki-fortigate"
   },
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 0,
    "y": 0
   },
   "interval": "15s",
   "maxDataPoints": 60,
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki-fortigate"
     },
     "refId": "A",
     "expr": "sum(count_over_time({source=\"fortigate\", verdict=\"blocked\"}[1m])) or vector(0)",
     "queryType": "range",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "ALL CLEAR",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 51
       }
      ]
     },
     "mappings": [
      {
       "type": "range",
       "options": {
        "from": 0,
        "to": 0,
        "result": {
         "text": "ALL CLEAR",
         "index": 0
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 1,
        "to": 50,
        "result": {
         "text": "ELEVATED",
         "index": 1
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 51,
        "to": 1000000000000.0,
        "result": {
         "text": "UNDER ATTACK",
         "index": 2
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
